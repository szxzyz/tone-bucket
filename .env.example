# ═══════════════════════════════════════════════════════════════════════
# VUUUG (CashWatch / PaidAdz) — Environment Configuration Template
# Copy this file to .env and fill in YOUR values before running the app.
# No system value is hardcoded in the code — everything below controls it.
# ═══════════════════════════════════════════════════════════════════════

# ─── DATABASE ─────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/dbname
SESSION_SECRET=a-long-random-secret-string

# ─── TELEGRAM BOT ─────────────────────────────────────────────────────
# Bot token from @BotFather (required for bot features)
TELEGRAM_BOT_TOKEN=
# Canonical bot username WITHOUT the @ (e.g. Paid_Adzbot)
BOT_USERNAME=
# Aliases also accepted (picked automatically if BOT_USERNAME is unset):
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_ID=
# Public URL of the bot (e.g. https://t.me/YourBotName)
TELEGRAM_BOT_URL=
# Web App / Mini App URL (https://yourdomain.com)
TELEGRAM_APP_URL=
TELEGRAM_WEBAPP_NAME=

# ─── ADMIN ─────────────────────────────────────────────────────────────
# Telegram user id(s) of the super admin (the one true master admin)
TELEGRAM_ADMIN_ID=
# Optional comma-separated pool of sub-admin Telegram user ids
TELEGRAM_ADMIN_IDS=

# ─── CHANNEL / GROUP ───────────────────────────────────────────────────
# Mandatory app access gate. Users must join each configured resource below,
# including the payout-proof channel when its link or chat ID is configured.
# Keep true in production; set false only for local/testing environments.
REQUIRE_CHANNEL_JOIN=true

# Channel (numeric chat id is recommended, e.g. -1001234567890)
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_LINK=https://t.me/YourChannel
TELEGRAM_CHANNEL_NAME=Your Channel Name
# Group / community
TELEGRAM_GROUP_ID=
TELEGRAM_GROUP_LINK=https://t.me/YourGroup
TELEGRAM_GROUP_NAME=Your Group Name
# Developer/update channel (legacy notification channel)
TELEGRAM_DEV_CHANNEL_ID=
TELEGRAM_DEV_CHANNEL_URL=https://t.me/YourDevChannel
TELEGRAM_DEV_CHANNEL_NAME=YourDevChannel
# Official payout-proof channel. Users must join this channel to access the app
# when configured, and the welcome-message 💸 PAYOUTS button opens this link.
# For membership verification, set the numeric chat ID (recommended) or a public
# channel URL (https://t.me/ChannelName); invite links need the matching chat ID.
TELEGRAM_PAYOUT_CHANNEL_ID=
TELEGRAM_PAYOUT_CHANNEL_LINK=https://t.me/YourPayoutChannel
TELEGRAM_PAYOUT_CHANNEL_NAME=Your Payout Channel

# ─── SUPPORT ───────────────────────────────────────────────────────────
# Support bot URL used by app Support buttons and banned/rejected users.
# This is served to the client through /api/config/app; avoid hardcoding links in UI.
SUPPORT_BOT_LINK=https://t.me/YourSupportBot

# Optional legacy payment-proof destination used only when TELEGRAM_PAYOUT_CHANNEL_LINK is unset.
# The Account page uses the same payout channel URL as the Telegram bot's PAYOUTS inline button.
PROOF_OF_PAYMENT_URL=

# ─── WITHDRAWALS ───────────────────────────────────────────────────────
# Numeric supergroup/chat id where withdrawal requests are posted (starts with -)
WITHDRAWAL_GROUP_CHAT_ID=-1001234567890
WITHDRAWAL_GROUP_LINK=https://t.me/YourWithdrawGroup

# ─── ADSGRAM ADS ───────────────────────────────────────────────────────
# Popup ad shown once at first app open
ADSGRAM_POPUP_BLOCK_ID=
# Reward ad used in the Ad Watch section
ADSGRAM_REWARD_BLOCK_ID=
# Extra reward ad (hamburger menu)
ADSGRAM_HAMBURGER_BLOCK_ID=
# Promo code claim ad
ADSGRAM_PROMO_BLOCK_ID=
# Daily check-in ad
ADSGRAM_CHECKIN_BLOCK_ID=
# Mystery box ad
ADSGRAM_MYSTERY_BLOCK_ID=
# Server-side reward callback secret (configured in your AdsGram dashboard Reward URL)
ADSGRAM_REWARD_SECRET=

# ─── MONETAG ───────────────────────────────────────────────────────────
# Rewarded interstitial zone id (also injected into index.html at build time)
VITE_MONETAG_ZONE_ID=
MONETAG_ZONE_ID=

# ─── GIGAPUB ───────────────────────────────────────────────────────────
# Script id used in index.html (injected at build time)
VITE_GIGAPUB_SCRIPT_ID=
GIGAPUB_SCRIPT_ID=

# ─── USL ADS / TOWERADS ────────────────────────────────────────────────
# SDK URL (optional — default kept if unset)
USLADS_SDK_URL=https://uslads.com/sdk/tower-ads-v4.js
# Real API key from the USL Ads dashboard; never commit the value.
VITE_USL_ADS_API_KEY=
# Requested TowerAds placement.
VITE_USL_ADS_PLACEMENT_ID=plc_992db36dbed33f7c

# ─── DEPLOYMENT (Render / Replit auto-set these; set manually if needed) ─
PORT=5000
NODE_ENV=development
